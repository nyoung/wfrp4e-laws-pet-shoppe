{
  "_id": "C2l0Dt5qL2gqSSfB",
  "name": "Stubborn",
  "type": "trait",
  "img": "modules/wfrp4e-core/icons/traits/trait.png",
  "system": {
    "description": {
      "type": "String",
      "label": "Description",
      "value": "<p><span style=\"font-family: CaslonPro;\">Donkeys and mules often have the Stubborn trait, which increases their WP score by +20 and requires an Opposed Ride or Drive/Willpower Test whenever the rider or driver needs to bring the creature under control. If the test is a failure, the animal stops dead and refuses to go further. It can be induced to go forward by a successful Ride Test opposed by the creature&rsquo;s Willpower, or an opposed Charm Animal Test if someone is leading it by the bridle. In either case, it does not go faster than half Walking speed.</span></p>"
    },
