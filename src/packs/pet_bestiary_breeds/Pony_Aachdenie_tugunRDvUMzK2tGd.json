    {
      "_id": "Choc5ITEWgCW3b0E",
      "name": "Amble",
      "type": "trait",
      "img": "modules/wfrp4e-core/icons/traits/trait.png",
      "system": {
        "description": {
          "type": "String",
          "label": "Description",
          "value": "<p>The creature has a smooth gait, making it more comfortable to ride over long distances. Add +Amble hours to any length of time a rider can comfortably ride. Further, reduce the Combat Difficulty for&nbsp;<em>Shooting From Horseback</em>&nbsp;by 1 step.*</p>"
        },
        "gmdescription": {
          "type": "String",
          "label": "Description",
          "value": "<p>*<em>House Rules:</em> You can't ride a horse for longer than <strong>TB</strong> hours a day without picking up some <em>Fatigue Conditions</em>, depending upon the results of an<strong> Endurance Test</strong>. Further, <em>Shooting From Horseback</em> is a penalty of at least –20, depending upon the circumstances. Riders with the <em>Trick Riding</em> Talent reduce this difficulty by 1 step.</p>"
        },
